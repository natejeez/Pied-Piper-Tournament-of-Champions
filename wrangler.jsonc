{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pied-piper-tournament-of-champions",
  "main": "src/worker-v213-prod.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "PARTICIPANT_VOTES", "class_name": "ParticipantVoteStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ParticipantVoteStore"] }
  ],
  // The ID placeholder is informational; D1 still requires a real d1_databases binding.
  "vars": {
    "VOTE_STORAGE_BACKEND": "durable-objects",
    "VOTE_WRITES_PAUSED": "false",
    "VOTES_DATABASE_ID": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
